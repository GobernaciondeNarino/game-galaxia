# Audio generado por ElevenLabs (se regenera solo; nunca al repositorio)
cache/audio/*
!cache/audio/.gitkeep

# Contadores del limitador de peticiones.
# El directorio SÍ se versiona (con su .gitkeep) y su contenido no: es el mismo
# trato que cache/audio. Un «cache/limites/» a secas excluía la carpeta entera,
# así que en un despliegue por FTP no llegaba y había que acordarse de crearla a
# mano. Aquí el olvido es caro: sin poder escribir los contadores, los topes de
# gasto por IP no se aplican y nadie se entera hasta que llega la factura.
cache/limites/*
!cache/limites/.gitkeep

# Tablas de JPL Horizons: una por cuerpo y día, se rehacen solas
cache/efemerides/*
!cache/efemerides/.gitkeep

# Respuestas del asistente, guardadas solo para poder decirlas en voz alta
cache/respuestas/*
!cache/respuestas/.gitkeep

# Registros del backend
api/logs/*
!api/logs/.gitkeep
!api/logs/.htaccess

# Claves reales: solo se versiona la plantilla secrets.example.php
config/secrets.php

# Las texturas SÍ se versionan: 13 MB que permiten desplegar en Plesk con un
# solo «git pull», sin subir nada aparte. Licencias en CREDITOS.json.
# Se descargan y actualizan con: node tools/texturas.mjs
assets/skybox/*
!assets/skybox/.gitkeep

# Respuestas crudas de JPL Horizons: caché local de tools/datos-jpl.mjs
.cache-horizons/

# El modelo de MediaPipe SÍ se versiona (7,6 MB): así el despliegue en Plesk
# es un único «git pull» y no hay que acordarse de subirlo por FTP aparte, que
# es exactamente el fallo que dejó la primera versión sin funcionar.
# Se descarga y actualiza con: node tools/vendor.mjs mediapipe

# Sistema operativo / editores
.DS_Store
Thumbs.db
*.swp
node_modules/

# Caché de Python de la skill vendorizada
__pycache__/
*.pyc

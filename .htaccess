# ============================================================================
#  ORBIS — Interfaz holográfica del Sistema Solar
#  Configuración de Apache para hosting Plesk (PHP 8.1+, sin Node.js).
#  Todo el frontend se sirve como estático; /api son los únicos scripts PHP.
# ============================================================================

Options -Indexes
DirectoryIndex index.html

# Redirige «…/orbis» a «…/orbis/». Sin la barra final, el navegador resolvería
# css/, js/ y vendor/ contra el directorio padre y todo devolvería 404.
# Es el comportamiento por omisión de Apache, pero se deja explícito porque de
# él depende que la aplicación funcione en un subdirectorio.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# ---------------------------------------------------------------------------
# 1. HTTPS obligatorio
#    getUserMedia() (cámara y micrófono) solo funciona en contextos seguros.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Plesk puede terminar TLS en el proxy: aceptamos también X-Forwarded-Proto.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Tipos MIME
#    Apache no conoce .task, .wasm ni .mjs de serie: sin esto el navegador
#    rechaza los módulos ES y MediaPipe no arranca.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript            .js .mjs
  AddType application/json                  .json
  AddType application/wasm                  .wasm
  AddType application/octet-stream          .task
  AddType model/gltf-binary                 .glb
  AddType model/gltf+json                   .gltf
  AddType font/woff2                        .woff2
  AddType image/ktx2                        .ktx2
  AddType image/webp                        .webp
  AddType image/avif                        .avif
  AddType audio/mpeg                        .mp3
  AddType image/svg+xml                     .svg

  AddCharset UTF-8 .js .mjs .css .json .html .svg
</IfModule>

# ---------------------------------------------------------------------------
# 3. Compresión
#    Determinante en conexiones lentas: three.module.min.js pasa de ~356 kB
#    a ~90 kB con Brotli. Los .woff2, .mp3, .webp y .wasm ya vienen comprimidos.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain \
      application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
      application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 4. Caché
#    - vendor/ y assets/: inmutables durante un año (se versionan por ruta).
#    - js/, css/ y data/: revalidación obligatoria, para poder desplegar
#      correcciones sin pedir al usuario que vacíe la caché.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(woff2|jpg|jpeg|png|webp|avif|ktx2|glb|gltf|task|wasm|mp3|ogg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# vendor/ contiene copias con versión fijada: nunca cambian sin cambiar de ruta.
# El patrón no lleva ancla inicial para que funcione también cuando ORBIS se
# despliega en un subdirectorio (…/juegos/orbis/vendor/…).
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/vendor/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# ---------------------------------------------------------------------------
# 5. Cabeceras de seguridad y de permisos de dispositivo
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # La cámara y el micrófono solo puede pedirlos esta misma página.
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains" env=HTTPS

  # CSP: todo se sirve desde este origen. 'wasm-unsafe-eval' y blob: son
  # imprescindibles para el WASM y el worker de MediaPipe.
  # El hash corresponde al <script type="importmap"> de index.html; si se
  # modifica ese bloque hay que regenerarlo con:  node tools/csp-hash.mjs
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: 'sha256-YCCu03F1ixcvn8W0yQCzeR4w+4P+xDXzUcZ7u6ZtnnM='; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ---------------------------------------------------------------------------
# 6. Rutas privadas
#    config/ y cache/ tienen además su propio .htaccess (defensa en profundidad).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(config|api/lib|api/logs|tools|docs/borradores)/ - [F,L]
</IfModule>

<FilesMatch "^(\.htaccess|\.gitignore|\.env|composer\.(json|lock)|package(-lock)?\.json|.*\.md)$">
  Require all denied
</FilesMatch>

# El audio cacheado se entrega únicamente a través de api/tts.php.
<IfModule mod_rewrite.c>
  RewriteRule ^cache/ - [F,L]
</IfModule>
